{
  "name": "action-dryrun",
  "version": "0.1.0",
  "description": "Local protocol and CLI for reviewable agent action dry-run plans",
  "type": "module",
  "bin": {
    "action-dryrun": "src/cli.js"
  },
  "scripts": {
    "build": "node scripts/validate.js",
    "check": "node --check src/*.js test/*.test.js",
    "lint": "node --check src/*.js test/*.test.js",
    "test": "node --test",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "node scripts/pack-smoke.mjs",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent-skill",
    "dry-run",
    "cli",
    "oss"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "demo",
    "docs",
    "examples",
    "fixtures",
    "scripts",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/action-dryrun.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/action-dryrun/issues"
  },
  "homepage": "https://github.com/rogerchappel/action-dryrun#readme",
  "author": "Roger Chappel"
}
